# 8.5 Hz warble, so the two warbles beat against each other). Only on the ワレワレハ chants.
# =====================================================================================================
track: Alien Chant 2 voice=atlas style=robotic lang=en seed=15855 gain=-7 pan=-0.35 reverb=0.4 voice.robotic=1 voice.formant_scale=0.85 voice.vibrato_rate=8.5 voice.vibrato_depth=0.7 style.vibrato_depth=1 style.vibrato_min_note=0.05 style.vibrato_start=0 style.vibrato_fade=0.03
@ 16     # bar 5 - bar 8
B3 q ワ  B3 e レ  B3 e ワ  B3 e レ  B3 q. ワ  |  B3 e ウ  B3 e チュ  B3 q ウ  B3 e ジ  B3 e ン  E3 q ダ  |
G3 e ワ  G3 e ワ  C4 e ワ  C4 e レ  E4 e ワ  E4 e レ  G4 q ワ  |  F#4 e ウ  F#4 e チュ  D#4 e ウ  D#4 e ジ  B3 e ン  B3 e ダ  r q  |
@ 288    # bar 73 - bar 74
G3 e ワ  G3 e レ  G3 e ワ  G3 e レ  C4 q ワ  r q  |  B3 e ニ  B3 e ン  D#4 e ゲ  D#4 e ン  F#4 q ダ  r q  |
@ 501    # bar 126, beat 2
G#3 s ワ  G#3 s レ  C#4 s ワ  C#4 s レ  F4 q ワ
@ 522    # bar 131, beat 3 - bar 132: fading away under the aliens' review
B3 e ワ  B3 e レ  B3 e ワ  B3 e レ  |  G#3 q ワ  r e  G#3 e ウ  G#3 e チュ  G#3 e ウ  G#3 e ジ  G#3 e ン  |
curve: loudness 521.9:0 522:-3 528:-20 (linear)

# =====================================================================================================
# CROWD (HUMANS): the gang's sung lines and answers, written for atlas. vocals.py adds the unison doubles
# Crowd 2 (ember, right) and Crowd 3 (aurora, an octave up). Pitches stay at or below D#4 for ember.
# The shouts ("click!", "hey!", "help!") are on Crowd Shout.
# =====================================================================================================
track: Crowd voice=atlas style=rock lang=en seed=23774 gain=-5 pan=-0.6 reverb=0.35 voice.tension=0.45 style.timing_humanize=0.006 style.auto_breath=0
@ 110    # bar 28, beat 3 (D): echo of the 404
A3 e four  D3 e oh{overshoot=0,transition=0.03}  A3 q four  |
# bridge
@ 392    # bar 99 (Am) - bar 100 (B)
E3 e who  E3 e is  E3 e the  A3 e invader  A3 e +  E3 e +  r q  |  F#3 e who  F#3 e is  F#3 e the  B3 e invader  B3 e +  F#3 e +  r q  |
# breakdown: whispered (see the voicing curve)
@ 446.5  # bar 112, beat 3.5
B3 e hurry  B3 e +
# final chorus: the crowd sings the hook an octave under the AI (its calls are on Crowd Shout)
@ 447.5
F#3 e select  |  A3 q. +  D4 q. all  C#4 e invaders  B3 q +  G#3 q +
@ 463.5
F#3 e select  |  A3 q. +  D4 q. all  C#4 e invaders  B3 q +  G#3 q +
@ 480    # bar 121
A3 q prove  A3 e you're  D4 q. not  C#4 e a  B3 q robot  G#3 q +
@ 495.5
F#3 e select  |  B3 q. +  D4 q. all  B3 e invaders  C#4 q +  G#3 q +
# outro
@ 518.5  # bar 130, beat 3.5 (D): in the gap after "apocalypse"
A3 e five  D4 q stars{consonant_length=0.55}  |
curve: voicing 446.4:1 446.5:0 447.4:0 447.5:1 (linear)
curve: loudness 446.4:0 446.5:-4 447.4:-4 447.5:0 (linear)

